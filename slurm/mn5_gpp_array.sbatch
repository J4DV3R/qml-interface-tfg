#!/bin/bash
# Variational QCNN benchmark as a Slurm job array on MareNostrum 5 GPP.
#
# PLACEHOLDERS (to confirm with the BSC user documentation once access is
# granted; nothing here has been run on MN5): <ACCOUNT>, <QOS>, module names
# and the virtual-environment path. Compute nodes have no Internet access:
# install dependencies beforehand (see slurm/README.md).
#
# Usage:
#   sbatch --array=1-160%40 --export=ALL,JOBS_FILE=slurm/jobs/phaseC.txt slurm/mn5_gpp_array.sbatch
#
#SBATCH --job-name=qcnn-variational
#SBATCH --account=<ACCOUNT>
#SBATCH --qos=<QOS>
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --time=02:00:00
#SBATCH --output=slurm/logs/%x-%A_%a.out
#SBATCH --error=slurm/logs/%x-%A_%a.err

set -euo pipefail

: "${JOBS_FILE:?set JOBS_FILE to a file generated by experiments.make_variational_jobs}"
: "${REPO_DIR:=$SLURM_SUBMIT_DIR}"
: "${VENV_DIR:=$REPO_DIR/qml_env}"

cd "$REPO_DIR"
# module load <python-module>   # e.g. the Python version matching qml_env (3.14.x); confirm on MN5
source "$VENV_DIR/bin/activate"

export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1

ARGS=$(sed -n "${SLURM_ARRAY_TASK_ID}p" "$JOBS_FILE")
if [ -z "$ARGS" ]; then
  echo "no job on line ${SLURM_ARRAY_TASK_ID} of $JOBS_FILE" >&2
  exit 2
fi

LOG_DIR="slurm/logs/runs"
mkdir -p "$LOG_DIR"
START=$(date +%s)
set +e
# shellcheck disable=SC2086
python -B -m experiments.run_variational_benchmark $ARGS
CODE=$?
set -e
echo "ARGS=$ARGS" >> "$LOG_DIR/${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}.log"
echo "EXIT_CODE=$CODE WALL_SECONDS=$(( $(date +%s) - START )) HOST=$(hostname)" >> "$LOG_DIR/${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}.log"
exit $CODE
